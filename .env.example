# 🚀 ULTRA-POWERFUL TELEGRAM BOT V2 - CONFIGURATION TEMPLATE
# ═════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in your actual API keys and credentials
# 3. NEVER commit .env to git or version control
# 4. Keep .env file secure and protected
#

# ═══════════════════════════════════════════════════════════════
# TELEGRAM CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get channel ID from @userinfobot or Python:
# import aiogram
# bot = aiogram.Bot(token=TOKEN)
# chat = await bot.get_chat("@your_channel_name")
# print(chat.id)
TELEGRAM_CHANNEL_ID=your_channel_id_here

# ═══════════════════════════════════════════════════════════════
# FREE / CHEAP API KEYS (PRIORITY)
# ═══════════════════════════════════════════════════════════════

# Cerebras API - Ultra-fast, $0.0001/1K tokens
# Get key from: https://www.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_key_here

# Groq API - Fast, $0.0005/1K tokens
# Get key from: https://console.groq.com/
GROQ_API_KEY=your_groq_key_here

# DeepSeek API - Reasoning, $0.0007/1K tokens
# Get key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_key_here

# Google Gemini - Powerful, $0.0015/1K tokens
# Get key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Mistral AI - $0.002/1K tokens
# Get key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_key_here

# Together AI - $0.003/1K tokens
# Get key from: https://www.together.ai/
TOGETHER_API_KEY=your_together_key_here

# Cohere - $0.005/1K tokens
# Get key from: https://dashboard.cohere.com/
COHERE_API_KEY=your_cohere_key_here

# ═══════════════════════════════════════════════════════════════
# PREMIUM API KEYS (FALLBACK)
# ═══════════════════════════════════════════════════════════════

# OpenAI - $0.05/1K tokens (expensive!)
# Get key from: https://platform.openai.com/
# UNCOMMENT only if needed
# OPENAI_API_KEY=your_openai_key_here

# Anthropic - $0.08/1K tokens (expensive!)
# Get key from: https://console.anthropic.com/
# UNCOMMENT only if needed
# ANTHROPIC_API_KEY=your_anthropic_key_here

# ═══════════════════════════════════════════════════════════════
# BACKUP API - LAST RESORT ONLY ($20/month budget)
# ═══════════════════════════════════════════════════════════════

# OpenRouter - Meta LLM router, $20 budget monthly
# Get key from: https://openrouter.ai/
# This is protected and only used as LAST FALLBACK
OPENROUTER_API_KEY=your_openrouter_key_here

# ═══════════════════════════════════════════════════════════════
# NEWS & DATA SOURCES
# ═══════════════════════════════════════════════════════════════

# NewsAPI - For latest news articles
# Get key from: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# ═══════════════════════════════════════════════════════════════
# OPTIONAL: CUSTOM SETTINGS
# ═══════════════════════════════════════════════════════════════

# Post generation language (default: uz for Uzbek)
POST_LANGUAGE=uz

# Maximum words per post (default: 1000)
MAX_WORDS_PER_POST=1000

# Minimum words per post (default: 800)
MIN_WORDS_PER_POST=800

# Cache expiration in hours (default: 24)
CACHE_EXPIRATION_HOURS=24

# Enable debug logging (default: false)
DEBUG_MODE=false

# ═══════════════════════════════════════════════════════════════
# SECURITY NOTES
# ═══════════════════════════════════════════════════════════════
# ⚠️  IMPORTANT:
# - NEVER commit this file to git or public repositories
# - NEVER share your API keys with anyone
# - Keep .env file in .gitignore
# - Rotate API keys every 3-6 months
# - Monitor usage for unauthorized access
# - If a key is compromised, rotate it immediately
#
# .gitignore entry:
# .env
# .env.local
# *.env
# ═════════════════════════════════════════════════════════════════
